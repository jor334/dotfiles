#!/bin/bash
# Toggles ALL windows in the focused workspace between tiling and floating.
# Direction is decided by the currently focused window's layout.

focused_layout=$(aerospace list-windows --focused --format '%{window-layout}')

if [ "$focused_layout" = "floating" ]; then
  target="tiling"
else
  target="floating"
fi

aerospace list-windows --workspace focused --format '%{window-id}' | while read -r id; do
  aerospace layout "$target" --window-id "$id"
done
