#!/bin/bash

# SketchyBar config entrypoint. See: https://felixkratz.github.io/SketchyBar/config

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

ICON_FONT="Hack Nerd Font"

##### Bar Appearance #####
# This MacBook Air has a notch; reserve space for it so left/right items
# don't render underneath the camera housing.
sketchybar --bar \
  height=32 \
  blur_radius=30 \
  position=top \
  padding_left=10 \
  padding_right=10 \
  color=$BASE \
  border_width=0 \
  notch_width=190 \
  y_offset=0

##### Global defaults #####
sketchybar --default \
  updates=when_shown \
  icon.font="$ICON_FONT:Regular:14.0" \
  icon.color=$TEXT \
  label.font="SF Pro:Semibold:13.0" \
  label.color=$TEXT \
  padding_left=5 \
  padding_right=5 \
  label.padding_left=4 \
  label.padding_right=4 \
  icon.padding_left=4 \
  icon.padding_right=4

##### Apple logo (left corner, decorative) #####
sketchybar --add item apple left \
  --set apple icon="$APPLE" icon.font="$ICON_FONT:Bold:15.0" label.drawing=off \
  padding_left=8 padding_right=12 \
  click_script="open -a 'Mission Control'"

##### Workspaces (AeroSpace) #####
# Only workspaces with open windows are shown (Brave is ignored — it lives
# on a real macOS Space, not an AeroSpace workspace). The focused one is
# highlighted with an animated background. Switching workspaces and opening
# new windows refresh instantly via AeroSpace hooks (see .aerospace.toml);
# update_freq is just a safety net that catches closed apps/windows, which
# AeroSpace has no hook for.
MAX_APPS_PER_SPACE=4

for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space.$sid left \
    --set space.$sid \
    icon="$sid" \
    icon.font="SF Pro:Bold:13.0" \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label.drawing=off \
    padding_left=0 \
    padding_right=0 \
    update_freq=5 \
    click_script="aerospace workspace $sid" \
    script="$PLUGIN_DIR/aerospace.sh $sid"

  bracket_members="space.$sid"
  for slot in $(seq 0 $((MAX_APPS_PER_SPACE - 1))); do
    # NOTE: icon.drawing must stay "on" — turning it off disables the whole
    # icon subsystem (text *and* background *and* image), not just the
    # glyph. We just leave the icon text empty instead.
    sketchybar --add item space.$sid.app.$slot left \
      --set space.$sid.app.$slot \
      drawing=off \
      icon="" \
      icon.background.drawing=on \
      icon.background.height=20 \
      icon.background.corner_radius=5 \
      icon.background.image.scale=0.75 \
      icon.padding_left=3 \
      icon.padding_right=3 \
      label.drawing=off \
      padding_left=0 \
      padding_right=0
    bracket_members="$bracket_members space.$sid.app.$slot"
  done

  # Group the number + its app icons under one shared rounded background —
  # a single "box" per workspace instead of separate floating pieces.
  sketchybar --add bracket space_bracket.$sid $bracket_members \
    --set space_bracket.$sid \
    background.color=$SURFACE \
    background.border_color=$SURFACE \
    background.corner_radius=8 \
    background.height=26 \
    background.drawing=on \
    padding_left=3 \
    padding_right=3
done

sketchybar --add item space_separator left \
  --set space_separator icon="|" icon.font="SF Pro:Regular:13.0" icon.color=$SURFACE_DIM label.drawing=off \
  padding_left=6 padding_right=10

##### Front app (currently focused app's real icon + name) #####
# Hidden while Brave is focused — Brave lives on a real macOS Space, not an
# AeroSpace workspace, and shouldn't show up anywhere in this bar.
sketchybar --add item front_app left \
  --set front_app \
  icon="" \
  icon.background.drawing=on \
  icon.background.height=20 \
  icon.background.corner_radius=4 \
  icon.background.image.scale=0.7 \
  icon.background.padding_left=2 \
  icon.background.padding_right=6 \
  label.font="SF Pro:Semibold:13.0" \
  --subscribe front_app front_app_switched

# Stay hidden until the first real front_app_switched event — querying the
# frontmost app at LaunchAgent startup is unreliable (System Events can
# report a stale/background process before the desktop session settles).
sketchybar --set front_app drawing=off

##### Right side: wifi, volume, battery, clock #####
sketchybar --add item wifi right \
  --set wifi icon.font="$ICON_FONT:Regular:13.0" label.drawing=off update_freq=15 script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item volume right \
  --set volume icon.font="$ICON_FONT:Regular:13.0" script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item battery right \
  --set battery icon.font="$ICON_FONT:Regular:13.0" update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change

sketchybar --add item clock right \
  --set clock icon.drawing=off update_freq=10 script="$PLUGIN_DIR/clock.sh" \
  --subscribe clock system_woke

sketchybar --update
